# Copy this file to .env and fill in your values (then `export $(cat .env | xargs)`
# or use python-dotenv / your shell's env loading of choice).

# Google AI Studio -- free tier, one key covers both the fact-checker's own
# Gemini calls and Graphiti's internal entity-extraction calls.
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Neo4j Graph Database Sandbox -- create one at https://sandbox.neo4j.com/
# or use a free Neo4j AuraDB instance. Use the bolt/neo4j+s URI it gives you.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=

# IMPORTANT: check your Aura instance's own Developer Hub -> Python snippet.
# Some Aura instances do NOT use the classic username "neo4j" or database
# name "neo4j" -- they use the instance's database ID for both instead
# (visible in that generated snippet's AUTH tuple and database_= argument).
# Copy whatever your instance's own snippet actually shows, not these
# placeholder defaults.


# Optional: silence Graphiti's anonymous usage telemetry
GRAPHITI_TELEMETRY_ENABLED=false

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
